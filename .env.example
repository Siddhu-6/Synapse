# Synapse configuration. Copy to .env and edit. Every key is optional unless marked REQUIRED.
# Full explanation of each value, and what to change for production: see the PDF guide, section 3.

# --- model (local) ---
SYNAPSE_LLM_PROVIDER=ollama              # ollama | openai (any OpenAI-compatible API as the main model)
SYNAPSE_MODEL=qwen2.5:7b-instruct        # 7B is the practical minimum for reliable planning
SYNAPSE_EMBED_MODEL=nomic-embed-text     # optional; memory falls back to keyword search
SYNAPSE_OLLAMA_URL=http://localhost:11434
# SYNAPSE_OPENAI_BASE_URL=https://api.groq.com/openai/v1   # only when SYNAPSE_LLM_PROVIDER=openai
# SYNAPSE_OPENAI_API_KEY=
SYNAPSE_LLM_TIMEOUT=180                  # seconds per model call; lower (60) with a hosted model
# SYNAPSE_NUM_CTX=8192                   # Ollama context window; bigger = slower
# SYNAPSE_KEEP_ALIVE=30m                 # keep the model loaded between calls
# SYNAPSE_PLAN_MAX_TOKENS=700
# SYNAPSE_GEN_MAX_TOKENS=1200            # longest answer/note the writer may produce

# --- model (fast, hosted; free tiers) — the biggest speed and quality upgrade ---
# Groq: https://console.groq.com/keys   Cerebras: https://cloud.cerebras.ai
# SYNAPSE_FAST_BASE_URL=https://api.groq.com/openai/v1
# SYNAPSE_FAST_MODEL=openai/gpt-oss-120b
# SYNAPSE_FAST_API_KEY=gsk_...          # put your real key in .env, never in this file

# --- paths ---
SYNAPSE_VAULT_PATH=/Users/siddhu/Desktop/Synapse-Vault        # REQUIRED in practice: the folder Obsidian has open (absolute path)
SYNAPSE_DATA_DIR=./data                  # SQLite state: runs, traces, memory, schedules, Google token

# --- budgets and guard rails ---
SYNAPSE_TOOL_TIMEOUT=30                  # seconds before a tool call is abandoned
SYNAPSE_MAX_STEPS=8                      # longest plan allowed
SYNAPSE_MAX_REPLANS=1                    # retries after a failed step
SYNAPSE_MAX_LLM_CALLS=20                 # hard per-run budget; stops runaway loops
# SYNAPSE_PARALLEL_STEPS=2               # independent read-only steps run together
SYNAPSE_CREW_TIMEOUT=600

# --- features ---
SYNAPSE_ENABLE_CREW=true                 # needs: uv pip install -e ".[crew]"
# SYNAPSE_CREW_CRITIC=false              # 3rd crew agent; roughly doubles crew time
SYNAPSE_ENABLE_WEB=true
# SYNAPSE_ENABLE_SCHEDULER=true          # scheduled goals run only while the API is up
# SYNAPSE_SCHEDULER_INTERVAL=30

# --- api ---
SYNAPSE_HOST=127.0.0.1                   # keep 127.0.0.1; put a proxy or tunnel in front for outside access
SYNAPSE_PORT=8000
# Who messages are drafted for. Optional: otherwise Synapse uses what you told it ("my name is ...").
# SYNAPSE_USER_NAME=
# SYNAPSE_USER_EMAIL=

# SYNAPSE_API_TOKEN=                     # REQUIRED before anything but this machine can reach the port
#   generate one with: openssl rand -hex 32

# --- integrations ---
# SYNAPSE_NOTION_TOKEN=ntn_...           # notion.so/my-integrations, then share pages with the integration
# SYNAPSE_N8N_WEBHOOKS=whatsapp=https://your-n8n/webhook/abc,slack=https://your-n8n/webhook/def
# SYNAPSE_N8N_SECRET=                    # sent as X-Synapse-Secret; check it in n8n (Header Auth)
#   generate one with: openssl rand -hex 24
